{
  "entities": {
    "User": {
      "title": "User",
      "description": "Utilisateur de la plateforme",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "university": { "type": "string" },
        "referralCode": { "type": "string" },
        "referralsCount": { "type": "number" },
        "fcmToken": { "type": "string" },
        "notificationPreferences": { "type": "object" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referralCode", "referralsCount", "createdAt"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Enregistrement d'un parrainage",
      "type": "object",
      "properties": {
        "inviterId": { "type": "string" },
        "invitedUserId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviterId", "invitedUserId", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Historique des notifications utilisateur",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["documents", "internships", "forums", "contests", "events", "system"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    },
    "PublicServiceContest": {
      "title": "Concours Fonction Publique",
      "description": "Sujets et QCM de préparation aux concours",
      "type": "object",
      "properties": {
        "titre": { "type": "string" },
        "categorie": { "type": "string", "enum": ["culture_generale", "maths", "droit", "economie", "svt", "physique", "dissertation_redaction", "tests_psychotechniques", "cas_pratique"] },
        "type": { "type": "string", "enum": ["qcm", "dissertation", "exercice", "simulation"] },
        "niveau": { "type": "string", "enum": ["BEPC", "BAC", "Licence"] },
        "duree": { "type": "number" },
        "difficulte": { "type": "string", "enum": ["facile", "moyen", "difficile"] },
        "questions": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "date_creation": { "type": "string", "format": "date-time" }
      }
    },
    "PublicServiceResult": {
      "title": "Résultat Concours",
      "description": "Historique des performances aux tests",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "concours_id": { "type": "string" },
        "score": { "type": "number" },
        "temps": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      }
    },
    "PublicServiceSubscription": {
      "title": "Abonnement Concours",
      "description": "Statut d'abonnement au module concours",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "actif": { "type": "boolean" },
        "date_debut": { "type": "string", "format": "date-time" },
        "date_fin": { "type": "string", "format": "date-time" }
      }
    },
    "PrintOrder": {
      "title": "Commande d'impression",
      "description": "Ordre d'impression documentaire de la plateforme",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "pageCount": { "type": "number" },
        "options": { "type": "object" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string" },
        "pickupPoint": { "type": "string" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Scholarship": {
      "title": "Bourses & Opportunités",
      "description": "Offres de bourses internationales pour étudiants africains",
      "type": "object",
      "properties": {
        "titre": { "type": "string" },
        "pays": { "type": "string" },
        "niveau": { "type": "string" },
        "domaine": { "type": "string" },
        "description": { "type": "string" },
        "date_limite": { "type": "string", "format": "date" },
        "lien_officiel": { "type": "string" },
        "source": { "type": "string" },
        "resume_ia": { "type": "string" },
        "date_publication": { "type": "string", "format": "date-time" },
        "tags": { "type": "array" }
      },
      "required": ["titre", "lien_officiel", "date_publication"]
    },
    "CommunityVideo": {
      "title": "Campus Shorts",
      "description": "Courtes vidéos éducatives ou communautaires",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "userPhoto": { "type": "string" },
        "university": { "type": "string" },
        "groupId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "hashtags": { "type": "array" },
        "category": { "type": "string", "enum": ["Cours", "Astuces Examens", "Vie Étudiante", "Orientation", "Opportunités", "Humour Campus", "Motivation"] },
        "visibility": { "type": "string", "enum": ["public", "friends", "group", "university"] },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "viewsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "isVerifiedEducational": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "videoUrl", "category", "visibility", "createdAt"]
    },
    "VideoComment": {
      "title": "Commentaire Vidéo",
      "description": "Commentaire sur un Campus Short",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "photo": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "message", "createdAt"]
    },
    "VideoLike": {
      "title": "Like Vidéo",
      "description": "Indique qu'un utilisateur aime une vidéo",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "videoId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "videoId", "createdAt"]
    },
    "VideoReport": {
      "title": "Signalement Vidéo",
      "description": "Signalement d'un contenu inapproprié",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "reportedBy": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "reportedBy", "reason", "createdAt"]
    },
    "ProcessedDocument": {
      "title": "Document Traité",
      "description": "Document académique traité par IA",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "filiere": { "type": "string" },
        "universite": { "type": "string" },
        "niveau": { "type": "string" },
        "originalFileUrl": { "type": "string" },
        "processedPdfUrl": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "pages": { "type": "number" },
        "tags": { "type": "array" },
        "validated": { "type": "boolean" },
        "views": { "type": "number" },
        "downloads": { "type": "number" }
      },
      "required": ["title", "originalFileUrl", "processedPdfUrl", "uploadedBy", "createdAt"]
    },
    "PublicExamQuiz": {
      "title": "Quiz Concours",
      "description": "Quiz interactif généré à partir de sujets de concours",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "concours": { "type": "string" },
        "categorie": { "type": "string" },
        "annee": { "type": "number" },
        "questions": { "type": "array" },
        "corrections": { "type": "array" },
        "generatedByAI": { "type": "boolean" },
        "validated": { "type": "boolean" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "difficulty": { "type": "string" },
        "tags": { "type": "array" },
        "duration": { "type": "number" }
      },
      "required": ["title", "concours", "annee", "questions", "createdAt"]
    },
    "UserReport": {
      "title": "User Report",
      "description": "Signalement pour contenu inapproprié ou abusif",
      "type": "object",
      "properties": {
        "reportedItemId": { "type": "string" },
        "reportedItemType": { "type": "string" },
        "reason": { "type": "string" },
        "reporterId": { "type": "string" },
        "reporterName": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportedItemId", "reportedItemType", "reason", "reporterId", "createdAt"]
    },
    "FinancingProfile": {
      "title": "Profil de Financement",
      "description": "Profil d'éligibilité financière d'un étudiant",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "academicLevel": { "type": "string" },
        "academicLevelScore": { "type": "number" },
        "profileCompletionScore": { "type": "number" },
        "activityScore": { "type": "number" },
        "documentsScore": { "type": "number" },
        "totalEligibilityScore": { "type": "number" },
        "eligibilityBadge": { "type": "string", "enum": ["Peu Éligible", "Moyennement Éligible", "Très Éligible", "Excellent"] },
        "documents": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userEmail", "totalEligibilityScore", "createdAt"]
    },
    "AidApplication": {
      "title": "Demande d'Aide Financière",
      "description": "Demande d'aide ponctuelle soumise par un étudiant",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["bourse_nationale", "aide_logement", "aide_transport", "aide_scolarite", "aide_alimentaire", "aide_manuels"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "status", "createdAt"]
    }
  },
  "firestore": {
    "/financing_profiles/{profileId}": {
      "schema": "FinancingProfile",
      "description": "Profils de financement et de scoring d'éligibilité des étudiants"
    },
    "/aid_applications/{applicationId}": {
      "schema": "AidApplication",
      "description": "Fiches de demande d'aide financière étudiante"
    },
    "/reports/{reportId}": {
      "schema": "UserReport",
      "description": "Signalements de contenu abusif"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Profils utilisateurs"
    },
    "/referrals/{referralId}": {
      "schema": "Referral",
      "description": "Suivi des parrainages"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Historique des notifications"
    },
    "/public_service_contests/{contestId}": {
      "schema": "PublicServiceContest",
      "description": "Base de données des concours"
    },
    "/public_service_results/{resultId}": {
      "schema": "PublicServiceResult",
      "description": "Résultats des tests"
    },
    "/public_service_subscriptions/{subId}": {
      "schema": "PublicServiceSubscription",
      "description": "Abonnements au module"
    },
    "/commandes_impression/{orderId}": {
      "schema": "PrintOrder",
      "description": "Commandes d'impression du kiosque"
    },
    "/bourses/{bourseId}": {
      "schema": "Scholarship",
      "description": "Base de données des bourses et opportunités"
    },
    "/community_videos/{videoId}": {
      "schema": "CommunityVideo",
      "description": "Vidéos de la communauté"
    },
    "/community_videos/{videoId}/comments/{commentId}": {
      "schema": "VideoComment",
      "description": "Commentaires des vidéos"
    },
    "/video_likes/{likeId}": {
      "schema": "VideoLike",
      "description": "Likes des vidéos"
    },
    "/video_reports/{reportId}": {
      "schema": "VideoReport",
      "description": "Signalements des vidéos"
    },
    "/processed_documents/{docId}": {
      "schema": "ProcessedDocument",
      "description": "Documents académiques traités"
    },
    "/public_exam_quizzes/{quizId}": {
      "schema": "PublicExamQuiz",
      "description": "Quiz de concours générés"
    }
  }
}
