{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "university": { "type": "string" },
        "major": { "type": "string" },
        "level": { "type": "string" },
        "promotion": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "tutor", "admin", "teacher", "institution", "parent", "alumni"] },
        "avatarUrl": { "type": "string" },
        "tutorStatus": { "type": "string", "enum": ["none", "pending", "approved", "rejected"] },
        "teacherStatus": { "type": "string", "enum": ["none", "pending_approval", "approved", "rejected"] }
      },
      "required": ["email", "firstName", "lastName", "role"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Public user profile for search",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "university": { "type": "string" },
        "major": { "type": "string" },
        "level": { "type": "string" },
        "promotion": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["firstName", "lastName", "university", "major"]
    },
    "Ad": {
      "title": "Ad",
      "description": "Marketplace advertisement",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "userId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "price", "userId", "category"]
    },
    "Document": {
      "title": "Document",
      "description": "Academic document",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["exam", "exercise", "summary", "thesis"] },
        "university": { "type": "string" },
        "major": { "type": "string" },
        "year": { "type": "string" },
        "subject": { "type": "string" },
        "authorId": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "downloads": { "type": "number" },
        "likes": { "type": "number" },
        "price": { "type": "number" },
        "isForSale": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "university", "subject", "downloadUrl", "authorId"]
    },
    "Internship": {
      "title": "Internship",
      "description": "Internship or job offer",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string", "enum": ["internship", "job", "employment"] },
        "description": { "type": "string" },
        "applicationMethod": { "type": "string", "enum": ["email", "url"] },
        "applicationValue": { "type": "string" },
        "deadline": { "type": "string" },
        "authorId": { "type": "string" },
        "postedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "company", "type", "authorId", "postedAt"]
    },
    "Event": {
      "title": "Event",
      "description": "University event",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["conference", "defense", "competition", "cultural", "other"] },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "organizerId": { "type": "string" },
        "attendees": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "date", "organizerId"]
    },
    "Group": {
      "title": "Group",
      "description": "Community group",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "members": { "type": "array" },
        "createdBy": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdBy"]
    },
    "Post": {
      "title": "Post",
      "description": "Community post",
      "type": "object",
      "properties": {
        "groupId": { "type": "string" },
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "likes": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "authorId", "content"]
    },
    "Portfolio": {
      "title": "Portfolio",
      "description": "Teacher portfolio",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "projects": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "title"]
    },
    "AlumniProfile": {
      "title": "AlumniProfile",
      "description": "Alumni mentorship profile",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatarUrl": { "type": "string" },
        "bio": { "type": "string" },
        "mentorshipTopics": { "type": "array" },
        "availability": { "type": "string" }
      },
      "required": ["userId", "userName", "bio"]
    },
    "News": {
      "title": "News",
      "description": "Campus news announcement",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "authorId", "createdAt"]
    },
    "LostAndFound": {
      "title": "LostAndFound",
      "description": "Lost and found item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["lost", "found"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "status", "userId", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A chat conversation between users",
      "type": "object",
      "properties": {
        "participants": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      },
      "required": ["conversationId", "senderId", "receiverId", "content", "timestamp", "read"]
    },
    "MotoRide": {
      "title": "MotoRide",
      "description": "A motorcycle ride offer",
      "type": "object",
      "properties": {
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "driverAvatar": { "type": "string" },
        "driverRating": { "type": "number" },
        "departure": { "type": "string" },
        "destination": { "type": "string" },
        "time": { "type": "string" },
        "date": { "type": "string" },
        "price": { "type": "number" },
        "distance": { "type": "string" },
        "motorcycle": { "type": "string" },
        "helmetAvailable": { "type": "boolean" },
        "whatsappNumber": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["driverId", "driverName", "departure", "destination", "time", "date", "price", "motorcycle", "whatsappNumber"]
    },
    "Log": {
      "title": "Log",
      "description": "User activity log",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "action", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "Public user profiles"
    },
    "/users/{userId}/reviews/{reviewId}": {
      "schema": "object",
      "description": "Teacher reviews"
    },
    "/ads/{adId}": {
      "schema": "Ad",
      "description": "Marketplace ads"
    },
    "/documents/{docId}": {
      "schema": "Document",
      "description": "Academic documents"
    },
    "/internships/{internshipId}": {
      "schema": "Internship",
      "description": "Internship offers"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "University events"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Community groups"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Community posts"
    },
    "/portfolios/{portfolioId}": {
      "schema": "Portfolio",
      "description": "Teacher portfolios"
    },
    "/alumniProfiles/{userId}": {
      "schema": "AlumniProfile",
      "description": "Alumni mentorship profiles"
    },
    "/news/{newsId}": {
      "schema": "News",
      "description": "Campus news"
    },
    "/lostAndFound/{itemId}": {
      "schema": "LostAndFound",
      "description": "Lost and found items"
    },
    "/comments/{commentId}": {
      "schema": "object",
      "description": "Post comments"
    },
    "/orientationProfiles/{userId}": {
      "schema": "object",
      "description": "User orientation profiles"
    },
    "/applications/{appId}": {
      "schema": "object",
      "description": "Tutor applications"
    },
    "/teacherApplications/{appId}": {
      "schema": "object",
      "description": "Teacher applications"
    },
    "/subscriptionRequests/{requestId}": {
      "schema": "object",
      "description": "Subscription requests"
    },
    "/notifications/{notifId}": {
      "schema": "object",
      "description": "User notifications"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Chat conversations"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages"
    },
    "/motoRides/{rideId}": {
      "schema": "MotoRide",
      "description": "Motorcycle ride offers"
    },
    "/logs/{logId}": {
      "schema": "Log",
      "description": "User activity logs"
    }
  }
}
