rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Public Service Contests rules
    match /public_service_contests/{contestId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }                
    
    match /public_service_contest_details/{document=**} {
      allow read: if isSignedIn();
    }
    
    match /public_service_results/{resultId} {
      allow read: if isOwner(resource.data.user_id);
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.user_id);
    }
    
    match /public_service_subscriptions/{subId} {
      allow read: if isOwner(resource.data.user_id);
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.user_id);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection
    match /test/connection {
      allow read: if true;
    }

    // Public/Authenticated Base Collections
    match /ads/{document=**} { allow read, write: if isSignedIn(); }
    match /documents/{document=**} { allow read, write: if isSignedIn(); }
    match /internships/{document=**} { allow read, write: if isSignedIn(); }
    match /events/{document=**} { allow read, write: if isSignedIn(); }
    match /groups/{document=**} { allow read, write: if isSignedIn(); }
    match /communityGroups/{document=**} { allow read, write: if isSignedIn(); }
    match /posts/{document=**} { allow read, write: if isSignedIn(); }
    match /news/{document=**} { allow read, write: if isSignedIn(); }
    match /lostAndFound/{document=**} { allow read, write: if isSignedIn(); }
    match /reports/{document=**} { allow read, write: if isSignedIn(); }
    match /quizzes/{document=**} { allow read, write: if isSignedIn(); }
    match /contests/{document=**} { allow read, write: if isSignedIn(); }
    match /deals/{document=**} { allow read, write: if isSignedIn(); }
    match /deal_suggestions/{document=**} { allow read, write: if isSignedIn(); }
    match /colocations/{document=**} { allow read, write: if isSignedIn(); }
    match /colocation_requests/{document=**} { allow read, write: if isSignedIn(); }
    match /colocation_reviews/{document=**} { allow read, write: if isSignedIn(); }
    match /contest_participants/{document=**} { allow read, write: if isSignedIn(); }
    match /comments/{document=**} { allow read, write: if isSignedIn(); }
    match /conversations/{document=**} { allow read, write: if isSignedIn(); }
    match /training_enrollments/{document=**} { allow read, write: if isSignedIn(); }
    match /training_reviews/{document=**} { allow read, write: if isSignedIn(); }
    match /marketplace/{document=**} { allow read, write: if isSignedIn(); }
    match /motoRides/{document=**} { allow read, write: if isSignedIn(); }
    match /trainings/{document=**} { allow read, write: if isSignedIn(); }
    match /notifications/{document=**} { 
      allow read: if isOwner(resource.data.userId) || resource.data.userId == 'all'; 
      allow update: if isOwner(resource.data.userId);
      allow create: if isSignedIn();
      allow delete: if isOwner(resource.data.userId);
    }
    match /applications/{document=**} { allow read, write: if isSignedIn(); }
    match /teacherApplications/{document=**} { allow read, write: if isSignedIn(); }
    match /subscriptionRequests/{document=**} { allow read, write: if isSignedIn(); }
    match /training_reports/{document=**} { allow read, write: if isSignedIn(); }
    match /logs/{document=**} { allow read, create: if isSignedIn(); }
    
    // Profiles collection
    match /profiles/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); 
    }

    // Referrals collection
    match /referrals/{document=**} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // Users collection
    match /users/{document=**} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Broaden for referral updates
    }
  }
}
