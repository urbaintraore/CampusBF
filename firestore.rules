rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // HELPERS & Pillar 3: Path Variable Hardening
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Pillar 4: Tiered Identity Logic
    // We check role directly in the User document to avoid client-side claims spoofing
    function getUserRole(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.role; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'urbain.traoreurb@gmail.com' ||
        getUserRole(request.auth.uid) == 'admin'
      ); 
    }
    function isTeacher() { return isSignedIn() && getUserRole(request.auth.uid) == 'teacher'; }

    // Pillar 2: Validation Blueprint Pattern
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'status']) &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['student', 'teacher', 'admin', 'alumni', 'parent', 'institution'] &&
             data.status in ['active', 'inactive', 'pending'];
    }

    function isValidScholarship(data) {
      return data.titre is string && data.titre.size() <= 1000 &&
             data.description is string && data.description.size() <= 10000 &&
             data.lien_officiel is string && data.lien_officiel.size() <= 1500;
    }

    function isValidVideo(data) {
      return data.userId == request.auth.uid &&
             data.videoUrl is string &&
             data.category in ["Cours", "Astuces Examens", "Vie Étudiante", "Orientation", "Opportunités", "Humour Campus", "Motivation"] &&
             data.visibility in ["public", "friends", "group", "university"] &&
             data.createdAt == request.time;
    }

    function isValidVideoComment(data) {
      return data.userId == request.auth.uid &&
             data.message is string &&
             data.createdAt == request.time;
    }

    function isValidVideoLike(data) {
      return data.userId == request.auth.uid &&
             data.videoId is string &&
             data.createdAt == request.time;
    }

    function isValidVideoReport(data) {
      return data.reportedBy == request.auth.uid &&
             data.videoId is string &&
             data.reason is string &&
             data.createdAt == request.time;
    }

    // -------------------------------------------------------------------------
    // PILLAR 0: Global Safety Net
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection
    match /test/connection {
      allow read: if true;
    }

    // -------------------------------------------------------------------------
    // PILLAR 6: PII Isolation & Schema Constraints
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // allow list: if isSignedIn(); // Block blanket reads - enforce via query in component
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        // Secure List Query: Forces client to filter
        (request.query.limit <= 50) || isAdmin()
      );
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        // Action: Profile Update (Immutable role/status for user)
        incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'avatarUrl', 'major', 'university', 'level', 'promotion', 'lastActiveAt', 'activityStats', 'rankingScore', 'lastDownloadAt', 'hasPostedPresentation', 'dailyQuests', 'streak', 'contributionCount', 'joinedGroups', 'forceUnlocked', 'forceUnlockReason'])
      ) || isAdmin();
    }

    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // CONTENT COLLECTIONS
    // -------------------------------------------------------------------------

    match /documents/{docId} {
      allow read: if isSignedIn();
      // Only admins/teachers create docs with validation
      allow create: if isSignedIn() && (isAdmin() || isTeacher());
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['downloads', 'likes', 'viewCount']));
      allow delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || (resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin() || (resource.data.authorId == request.auth.uid);
    }

    match /quizResults/{resultId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /public_service_questions/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    match /public_service_subscriptions/{id} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /communityGroups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isOwner(existing().authorId);
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isOwner(existing().authorId);
    }

    // Secure everything else with basic auth for now but move to specific schemas later
    match /ads/{id} { allow read: if true; allow write: if isAdmin(); }
    match /internships/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /bourses/{id} { 
      allow read: if true; 
      allow write: if isAdmin();
    }
    match /events/{id} { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /marketplace/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /motoRides/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /trainings/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /public_service_contests/{id} { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /public_service_contest_details/{id} { allow read: if isSignedIn(); allow write: if isAdmin() || isTeacher(); }
    match /public_service_results/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /logs/{id} { allow create: if isSignedIn(); allow read: if isAdmin(); }
    match /applications/{id} { allow read, write: if isSignedIn(); }
    match /teacherApplications/{id} { allow read, write: if isSignedIn(); }
    match /subscriptionRequests/{id} { allow read, write: if isSignedIn(); }

    match /deals/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /dealSuggestions/{id} { allow read, write: if isSignedIn(); }
    
    match /colocations/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /colocationRequests/{id} { allow read, write: if isSignedIn(); }
    match /colocationReviews/{id} { allow read: if isSignedIn(); allow write: if isSignedIn(); }

    // Campus Shorts
    match /community_videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidVideo(incoming());
      allow update: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isAdmin() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'viewsCount', 'sharesCount']))
      );
      allow delete: if isAdmin() || isOwner(resource.data.userId);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidVideoComment(incoming());
        allow delete: if isAdmin() || isOwner(resource.data.userId);
      }
    }

    match /video_likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidVideoLike(incoming());
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    match /video_reports/{reportId} {
      allow create: if isSignedIn() && isValidVideoReport(incoming());
      allow read: if isAdmin();
    }

    match /users/{userId}/reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isOwner(resource.data.authorId);
    }
  }
}
