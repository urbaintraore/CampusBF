rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // HELPERS & Pillar 3: Path Variable Hardening
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Pillar 4: Tiered Identity Logic
    // We check role directly in the User document to avoid client-side claims spoofing
    function getUserRole(uid) { 
      return exists(/databases/$(database)/documents/users/$(uid)) 
        ? get(/databases/$(database)/documents/users/$(uid)).data.role 
        : 'student'; 
    }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'urbain.traoreurb@gmail.com' ||
        request.auth.token.email == 'urbain.traore@yahoo.fr' ||
        request.auth.token.email == 'traoreurb@gmail.com' ||
        request.auth.token.email == 'urbain.traore@gmail.com' ||
        request.auth.token.email == 'admin@offline.local' ||
        getUserRole(request.auth.uid) == 'admin'
      ); 
    }
    function isTeacher() { 
      return isSignedIn() && (
        getUserRole(request.auth.uid) == 'teacher'
      ); 
    }

    // Pillar 2: Validation Blueprint Pattern
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'status']) &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['student', 'teacher', 'admin', 'alumni', 'parent', 'institution', 'public'] &&
             data.status in ['active', 'inactive', 'pending'];
    }

    function isValidScholarship(data) {
      return data.titre is string && data.titre.size() <= 1000 &&
             data.description is string && data.description.size() <= 10000 &&
             data.lien_officiel is string && data.lien_officiel.size() <= 1500;
    }

    function isValidVideo(data) {
      return data.userId == request.auth.uid &&
             data.videoUrl is string &&
             data.category in ["Orientation", "Universités", "Bourses", "IA & Tech", "Carrière", "Entrepreneuriat", "Motivation", "Sciences", "Examens", "Vie Étudiante"] &&
             data.createdAt == request.time;
    }

    function isValidVideoComment(data) {
      return data.userId == request.auth.uid &&
             data.message is string &&
             data.createdAt == request.time;
    }

    function isValidVideoLike(data) {
      return data.userId == request.auth.uid &&
             data.videoId is string &&
             data.createdAt == request.time;
    }

    function isValidVideoReport(data) {
      return data.reportedBy == request.auth.uid &&
             data.videoId is string &&
             data.reason is string &&
             data.createdAt == request.time;
    }

    function isValidReport(data) {
      return data.reporterId == request.auth.uid &&
             data.reportedItemId is string && data.reportedItemId.size() <= 128 &&
             data.reportedItemType in ['post', 'comment', 'document', 'internship', 'marketplace', 'event', 'lostAndFound', 'news', 'colocation', 'message'] &&
             data.reason is string && data.reason.size() <= 2000;
    }

    function isValidFinancingProfile(data) {
      return data.userId == request.auth.uid &&
             data.userEmail is string &&
             data.totalEligibilityScore is number &&
             data.totalEligibilityScore >= 0 && data.totalEligibilityScore <= 100;
    }

    function isValidAidApplication(data) {
      return data.userId == request.auth.uid &&
             data.type in ["bourse_nationale", "aide_logement", "aide_transport", "aide_scolarite", "aide_alimentaire", "aide_manuels"] &&
             data.amount is number && data.amount > 0 &&
             data.status in ["pending", "approved", "rejected"];
    }

    // -------------------------------------------------------------------------
    // PILLAR 0: Global Safety Net
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection
    match /test/connection {
      allow read: if true;
    }

    // -------------------------------------------------------------------------
    // PILLAR 6: PII Isolation & Schema Constraints
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // allow read to anyone so profiles load for visitors and unauthenticated sessions
      allow get: if true;
      allow list: if true;
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().role != 'admin' || 
        request.auth.token.email in ['urbain.traoreurb@gmail.com', 'urbain.traore@yahoo.fr', 'traoreurb@gmail.com', 'urbain.traore@gmail.com']
      );
      allow update: if isOwner(userId) && (
        // Action: Profile Update (Immutable role/status for user)
        incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'avatarUrl', 'major', 'university', 'level', 'promotion', 'lastActiveAt', 'activityStats', 'rankingScore', 'lastDownloadAt', 'recentDownloads', 'hasPostedPresentation', 'dailyQuests', 'streak', 'contributionCount', 'joinedGroups', 'forceUnlocked', 'forceUnlockReason', 'phone', 'city', 'neighborhood', 'ine', 'skills', 'notificationPreferences', 'bio', 'experiences']) &&
        (!incoming().keys().contains('role') || incoming().role == existing().role) &&
        (!incoming().keys().contains('status') || incoming().status == existing().status) &&
        (!incoming().keys().contains('motoRideStatus') || incoming().motoRideStatus == existing().motoRideStatus)
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // CONTENT COLLECTIONS
    // -------------------------------------------------------------------------

    match /documents/{docId} {
      allow read: if true;
      // Only admins/teachers create docs with validation
      allow create: if isSignedIn() && (isAdmin() || isTeacher());
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['downloads', 'likes', 'viewCount']));
      allow delete: if isAdmin();
    }

    match /processed_documents/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || 
                    (resource.data.authorId == request.auth.uid) || 
                    (resource.data.creatorId == request.auth.uid) || 
                    (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['playCount']));
      allow delete: if isAdmin() || (resource.data.authorId == request.auth.uid) || (resource.data.creatorId == request.auth.uid);
    }

    match /quizResults/{resultId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /public_service_questions/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    match /public_service_subscriptions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /communityGroups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['members', 'membersCount']))
      );
      allow delete: if isAdmin() || isOwner(resource.data.createdBy);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        isOwner(existing().authorId) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likedBy']))
      );
      allow delete: if isAdmin() || isOwner(existing().authorId);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        isOwner(existing().authorId) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likedBy']))
      );
      allow delete: if isAdmin() || isOwner(existing().authorId);
    }

    // Secure everything else with basic auth for now but move to specific schemas later
    match /contests/{id} { allow read: if true; allow write: if isAdmin(); }
    match /contest_participants/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /ads/{id} { allow read: if true; allow write: if isAdmin(); }
    match /internships/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bourses/{id} { 
      allow read: if true; 
      allow write: if isAdmin();
    }
    match /scholarships/{id} { 
      allow read: if true; 
      allow write: if isAdmin() || (isSignedIn() && (getUserRole(request.auth.uid) == 'tutor' || getUserRole(request.auth.uid) == 'alumni'));
    }
    match /financing_profiles/{profileId} {
      allow read: if isSignedIn() && (isOwner(profileId) || isAdmin());
      allow write: if isSignedIn() && isOwner(profileId) && isValidFinancingProfile(incoming());
    }
    match /aid_applications/{applicationId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && isValidAidApplication(incoming());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(resource.data.userId) && existing().status == "pending" && incoming().status == "pending" && isValidAidApplication(incoming()))
      );
      allow delete: if isSignedIn() && (isAdmin() || (isOwner(resource.data.userId) && existing().status == "pending"));
    }
    match /events/{id} { allow read: if true; allow write: if isAdmin() || isTeacher(); }
    match /marketplace/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /motoRides/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /trainings/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() ||
        isOwner(resource.data.trainerId) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['participants']))
      );
      allow delete: if isAdmin() || isOwner(resource.data.trainerId);
    }
    
    match /training_enrollments/{id} { allow read: if true; allow create: if isSignedIn(); }
    match /training_reviews/{id} { allow read: if true; allow create: if isSignedIn(); }
    match /training_reports/{id} { allow create: if isSignedIn(); allow read: if isAdmin(); }
    match /public_service_contests/{id} { 
      allow read: if true; 
      allow create: if true; // Temporarily allow all creations for iframe users
      allow delete: if isAdmin() || isTeacher();
      allow update: if true;
    }
    match /public_service_contest_details/{id} { allow read: if true; allow write: if true; }
    match /exam_processing_logs/{id} { allow read: if true; allow write: if true; }
    match /public_service_results/{id} { allow read: if true; allow create: if isSignedIn(); allow update, delete: if isAdmin(); }
    match /public_service_cheat_incidents/{id} { allow read: if true; allow create: if isSignedIn(); allow update, delete: if isAdmin(); }
    
    // Logs, activity logging, download logs
    match /logs/{id} { allow read: if true; allow create: if true; }
    match /activity_logs/{id} { allow read: if true; allow create: if true; allow update, delete: if isAdmin(); }
    match /downloads_logs/{id} { allow read: if true; allow create: if true; allow update, delete: if isAdmin(); }
    match /audit_logs/{id} { allow read: if true; allow create: if true; allow update, delete: if isAdmin(); }
    
    // Core administrative tracking collections
    match /applications/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /teacherApplications/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /subscriptionRequests/{id} { allow read: if true; allow write: if isSignedIn(); }

    // Deals and news
    match /deals/{id} { allow read: if true; allow write: if isAdmin(); }
    match /dealSuggestions/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /deal_suggestions/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /news/{id} { allow read: if true; allow write: if isAdmin() || isTeacher(); }
    match /lostAndFound/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /lost_and_found/{id} { allow read: if true; allow write: if isSignedIn(); }

    // Moto rides and offers
    match /motoRides/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /motorideOffers/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /motoride_offers/{id} { allow read: if true; allow write: if isSignedIn(); }
    
    match /colocations/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /colocationRequests/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /colocationReviews/{id} { allow read: if true; allow write: if isSignedIn(); }

    // Vidéos Communautaires
    match /community_videos/{videoId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidVideo(incoming());
      allow update: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isAdmin() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'viewsCount', 'sharesCount']))
      );
      allow delete: if isAdmin() || isOwner(resource.data.userId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidVideoComment(incoming());
        allow delete: if isAdmin() || isOwner(resource.data.userId);
      }
    }

    match /video_likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidVideoLike(incoming());
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    match /video_reports/{reportId} {
      allow create: if isSignedIn() && isValidVideoReport(incoming());
      allow read: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && isValidId(reportId) && isValidReport(incoming());
      allow read, delete: if true;
    }

    match /users/{userId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isOwner(resource.data.authorId);
    }
    
    // -------------------------------------------------------------------------
    // ACADEMIC INSTITUTION COLLECTIONS
    // -------------------------------------------------------------------------
    match /universities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /academic_departments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /academic_filieres/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /academic_classes/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['studentCount'])
      );
    }
    match /academic_students/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /academic_timetables/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /academic_documents/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['downloadsCount', 'viewsCount', 'likesCount'])
      );
    }
    match /academic_messages/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }
    match /academic_notifications/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readBy'])
      );
    }

    // Student tutor requests and responses
    match /student_tutor_requests/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /tutor_responses/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
