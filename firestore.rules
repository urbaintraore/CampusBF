rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function getUser(userId) { return get(/databases/$(database)/documents/users/$(userId)).data; }

    // Collections with default access for authenticated users
    match /ads/{document=**} { allow read: if isSignedIn(); }
    match /documents/{document=**} { allow read: if isSignedIn(); }
    match /internships/{document=**} { allow read: if isSignedIn(); }
    match /events/{document=**} { allow read: if isSignedIn(); }
    match /groups/{document=**} { allow read: if isSignedIn(); }
    match /posts/{document=**} { allow read: if isSignedIn(); }
    match /news/{document=**} { allow read: if isSignedIn(); }
    match /lostAndFound/{document=**} { allow read: if isSignedIn(); }
    match /reports/{document=**} { allow read: if isSignedIn(); }
    match /quizzes/{document=**} { allow read: if isSignedIn(); }
    match /contests/{document=**} { allow read: if isSignedIn(); }
    match /deals/{document=**} { allow read: if isSignedIn(); }
    match /deal_suggestions/{document=**} { allow read: if isSignedIn(); }
    match /colocations/{document=**} { allow read: if isSignedIn(); }
    match /colocation_requests/{document=**} { allow read: if isSignedIn(); }
    match /colocation_reviews/{document=**} { allow read: if isSignedIn(); }
    match /contest_participants/{document=**} { allow read: if isSignedIn(); }
    match /training_enrollments/{document=**} { allow read: if isSignedIn(); }
    match /training_reviews/{document=**} { allow read: if isSignedIn(); }
    match /marketplace/{document=**} { allow read: if isSignedIn(); }
    match /motoRides/{document=**} { allow read: if isSignedIn(); }
    match /trainings/{document=**} { allow read: if isSignedIn(); }
    match /notifications/{document=**} { allow read: if isSignedIn(); }
    match /applications/{document=**} { allow read: if isSignedIn(); }
    match /teacherApplications/{document=**} { allow read: if isSignedIn(); }
    match /subscriptionRequests/{document=**} { allow read: if isSignedIn(); }
    match /training_reports/{document=**} { allow read: if isSignedIn(); }
    match /logs/{document=**} { allow read, create: if isSignedIn(); }

    // Users collection
    match /users {
      allow list: if isSignedIn();
      match /{userId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId) && request.resource.data.referralsCount == 0;
        allow update: if isOwner(userId) && request.resource.data.referralsCount >= resource.data.referralsCount;
      }
    }

    // Referrals collection
    match /referrals {
      allow list: if isSignedIn();
      match /{referralId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() 
          && request.resource.data.inviterId != request.resource.data.invitedUserId
          && request.resource.data.invitedUserId == request.auth.uid;
      }
    }

    // Documents collection (Protected)
    match /documents/{docId} {
      allow read: if isSignedIn();
    }
  }
}
